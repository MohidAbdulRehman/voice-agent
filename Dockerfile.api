# syntax=docker/dockerfile:1
# The REST API with the built dashboard, as one image for Render (render.yaml).
#   docker build --file Dockerfile.api --tag intake-api .
#   docker run --env DATABASE_URL=... --publish 8000:8000 intake-api

# --- 1. Build the dashboard into src/intake/api/static --------------------------
FROM node:24-slim AS dashboard
WORKDIR /build/dashboard
COPY dashboard/package.json dashboard/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY dashboard/ ./
RUN npm run build

# --- 2. Install the app and its dependencies into /app/.venv with uv -----------
FROM python:3.12-slim AS app
COPY --from=ghcr.io/astral-sh/uv:0.11.9 /uv /bin/uv
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_NO_CACHE=1 \
    UV_PYTHON_DOWNLOADS=never
WORKDIR /app
# Dependencies first, so a code change doesn't reinstall them.
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --no-install-project
COPY README.md ./
COPY src/ src/
COPY --from=dashboard /build/src/intake/api/static src/intake/api/static
RUN uv sync --locked --no-dev && python -m compileall -q src

# --- 3. Runtime: Python, the virtualenv and the code, without build tools -------
FROM python:3.12-slim
RUN useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin app
COPY --from=app /app /app
WORKDIR /app
USER app
# Render's proxy is the only way in, and it puts the caller's address first in
# X-Forwarded-For, which is the entry uvicorn uses when every proxy is trusted.
# The rate limiter then keys on each caller instead of on the proxy.
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    FORWARDED_ALLOW_IPS="*"
EXPOSE 8000
# Render sets PORT. The API logs each request itself, without query strings.
CMD ["sh", "-c", "exec uvicorn intake.api.main:app --host 0.0.0.0 --port ${PORT:-8000} --no-access-log"]
