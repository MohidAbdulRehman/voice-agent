# =============================================================================
# .env.example: copy to .env and fill in. NEVER commit .env (it's git-ignored).
# Every variable is read through intake.config.Settings.
# =============================================================================

# --- LiveKit (telephony, agent hosting, and LiveKit Inference for the LLM) ---
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
AGENT_NAME=patient-intake                # must match the LiveKit dispatch rule
PUBLIC_PHONE_NUMBER=+1XXXXXXXXXX         # shown in README + dashboard banner

# --- Speech-to-text + fallback voice (Deepgram) ---
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_TTS_VOICE_EN=                   # an Aura-2 English voice id, from Deepgram's voice list
DEEPGRAM_TTS_VOICE_ES=                   # an Aura-2 Spanish voice id if available; blank = fallback stays English

# --- Primary voice (Cartesia) ---
CARTESIA_API_KEY=
CARTESIA_TTS_MODEL=sonic-3
CARTESIA_VOICE_EN=                       # voice id (warm General American)
CARTESIA_VOICE_ES=                       # voice id (Spanish)

# --- LLM: primary via LiveKit Inference (uses the LiveKit key above) ---
LLM_PRIMARY_MODEL=openai/gpt-4.1-mini
# --- LLM: fallback via Groq (only used if the primary fails) ---
GROQ_API_KEY=
LLM_FALLBACK_MODEL=llama-3.3-70b-versatile

# --- Database ---
# Supabase SESSION POOLER string (IPv4, port 5432). Alphanumeric password only.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
# Local Docker Postgres used by the test suite. Tests NEVER use DATABASE_URL.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/intake_test

# --- App ---
CLINIC_NAME=Riverside Family Clinic
AGENT_PERSONA_NAME=Maya
CLINIC_TIMEZONE=America/New_York
MAX_CALL_MINUTES=12                      # agent wraps up politely after this (protects free minutes)
API_CORS_ORIGINS=http://localhost:5173   # comma-separated; production dashboard is same-origin
PUBLIC_API_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
SIMULATE_DB_FAILURE=false                # true = repository writes raise (tests/demos of the failure path)
